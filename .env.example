# ---- Server ----
PORT=5000
NODE_ENV=development

# Public address of the app. Used for share links, QR codes and reset emails.
# For phone testing on your Wi-Fi use your PC address, e.g. http://192.168.1.10:5000
# REQUIRED in production.
APP_URL=http://localhost:5000

# Set to 1 when running behind ONE reverse proxy / load balancer (nginx, ALB).
# Leave as false when users connect directly to Node.
TRUST_PROXY=false

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skydrop?retryWrites=true&w=majority

# ---- Auth ----
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- AWS S3 ----
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-private-bucket-name

# Local testing ONLY. In production (EC2) leave these two commented out / unset
# so the AWS SDK automatically uses the instance's attached IAM Role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Email for password reset (optional in development) ----
# If SMTP_HOST is empty, the reset link is printed in the server console (development only).
# Works with Amazon SES SMTP, Gmail app passwords, Mailgun, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SkyDrop <no-reply@your-domain.com>"
